        "population_group_size": 250,
        "movement_probability": 0.05,
        "distribution_location": 0.0,
        "distribution_scale": 1000,
        "use_buckets": true,
        "__comment2__": "'distance_bucket_size' only used in 'use_buckets' is true",
        "distance_bucket_size": 500
    },
    "send_population_back_plugin": {},
    "gather_population_plugin": {},
    "node_dependency_data_plugin" : {
        "dependency_files": []
    },
    "custom_dependency_data_plugin" : {
        "dependency_rules": [
            {
                "rule_name": "dialysis_clinic_need_water_source",
