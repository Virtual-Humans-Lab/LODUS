        "clinic_node_type": "dialysis_clinic",
        "patient_node_type": "home",
        "clinic_name_attribute": "clinic_name",
        "clinic_data_file": "dialysis_clinics/opening_hours_example.csv",   
        "default_values": {
            "opening_step": 6,
            "closing_step": 18,
            "treatment_capacity_per_step": 2
        }
    }
    
   
