                "target_node_attribute": "water_source",
                "dependency_node_type": "water_source",
                "dependency_node_attribute": "eta_name",
                "dependency_rule": "min_of",
                "minimum_enabled": 1    

            }

        ]
    },
    "change_enabled_state_plugin": {},
