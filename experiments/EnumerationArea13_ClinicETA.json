{
    "envgraph_inputs_files": {
        "__comment1__": "Files will be loaded from the 'data_input' folder",
        "environment_file": ["enumeration_area/Environment-13-EnumArea.json", "dialysis_clinics/Environment-ETAs-13.json", "dialysis_clinics/Environment-Clinics-13.json"],
        "population_file": "enumeration_area/Population-13-EnumArea.json"
    },
     "simulation_parameters": {
        "cycles": 10,
        "cycle_length": 24
    },
    "levy_walk_plugin": {
        "__comment1__": "distance type: 1 = LongLat, 2 = Metres_Geopy, 3 = Metres_Pyproj",
        "distance_type": 3,
        "population_group_size": 250,
        "movement_probability": 0.05,
        "distribution_location": 0.0,
        "distribution_scale": 1000,
        "use_buckets": true,
        "__comment2__": "'distance_bucket_size' only used in 'use_buckets' is true",
        "distance_bucket_size": 500
    },
    "send_population_back_plugin": {},
    "gather_population_plugin": {},
    "node_dependency_data_plugin" : {
        "dependency_files": []
    },
    "custom_dependency_data_plugin" : {
        "dependency_rules": [
            {
                "rule_name": "dialysis_clinic_need_water_source",
                "target_node_type": "dialysis_clinic",
                "target_node_attribute": "water_source",
                "dependency_node_type": "water_source",
                "dependency_node_attribute": "eta_name",
                "dependency_rule": "min_of",
                "minimum_enabled": 1    

            }

        ]
    }
    
   
}