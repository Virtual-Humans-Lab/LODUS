@article{Koktavá_Horák_2023,
  title        = {Options for micro-mobility data visualization },
  volume       = {14},
  url          = {https://eurogeojournal.eu/index.php/egj/article/view/561},
  doi          = {10.48088/ejg.n.kok.14.4.046.052},
  abstractnote = {&amp;lt;p&amp;gt;The growth in technology has led to the enhancement of open data sources and the development of user-friendly open-source visualization and analysis tools. The evolution of these tools has resulted in the expansion of various analytical and visualization techniques. This research concentrates on the visualization methods used in micro-mobility studies. It briefly defines micro-mobility, including the key factors that influence it. The motivation for writing this paper was to identify visualization methods that are suitable for representing a variety of micro-mobility data types. The aim of this paper is to briefly review a number of visualization methods that are widely used in micro-mobility research.&amp;lt;/p&amp;gt;},
  number       = {4},
  journal      = {European Journal of Geography},
  author       = {Koktavá, Nikola and Horák, Jiří},
  year         = {2023},
  month        = {Nov.},
  pages        = {46–52}
}

